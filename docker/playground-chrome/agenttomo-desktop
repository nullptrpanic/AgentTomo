#!/bin/sh
# This process runs outside the traced tree. Docker owns its lifetime.
set -eu
umask 077
# x11vnc scans every possible FD at startup. Some Docker daemons set this
# limit above a billion; cap display helpers only, never the traced workload.
desktop_nofile=$(ulimit -n)
if [ "$desktop_nofile" = unlimited ] || [ "$desktop_nofile" -gt 4096 ]; then
    ulimit -n 4096
fi
state=/tmp/agenttomo-desktop
mkdir -p "$state"
# The root terminal waits for ready from its nested user namespace. Allow path
# traversal while keeping the cookie and display logs private to the browser.
chmod 0711 "$state"
export DISPLAY=:99 XAUTHORITY="$state/Xauthority"
touch "$XAUTHORITY"
xauth -f "$XAUTHORITY" add "$DISPLAY" . "$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
children=
cleanup() {
    rm -f "$state/ready"
    for pid in $children; do kill "$pid" 2>/dev/null || :; done
    wait || :
}
trap cleanup EXIT
trap 'exit 0' INT TERM
Xvfb "$DISPLAY" -screen 0 1280x800x24 -nolisten tcp -noreset -auth "$XAUTHORITY" >"$state/xvfb.log" 2>&1 &
children="$!"
attempt=0
until xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 100 ]; then cat "$state/xvfb.log" >&2; exit 1; fi
    sleep 0.1
done
openbox --sm-disable >"$state/openbox.log" 2>&1 &
children="$children $!"
x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -localhost -rfbport 5900 \
    -nopw -forever -shared -noxdamage -xkb -quiet >"$state/vnc.log" 2>&1 &
vnc=$!
children="$children $vnc"
attempt=0
until python3 -c 'import socket; s=socket.create_connection(("127.0.0.1",5900),0.2); s.settimeout(0.2); assert s.recv(12).startswith(b"RFB ")' 2>/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 100 ]; then cat "$state/vnc.log" >&2; exit 1; fi
    sleep 0.1
done
touch "$state/ready"
printf 'READY\n'
wait "$vnc"
